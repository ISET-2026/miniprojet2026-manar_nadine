{% extends 'base.html.twig' %}
{% block title %}Ajouter un ingrédient{% endblock %}

{% block body %}

<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h5 class="section-title">{{ recette.titre }}</h5>
        <h1 class="display-3 text-white mb-0">🛒 Ajouter un Ingrédient</h1>
    </div>
</div>

<div class="container-fluid px-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 wow fadeIn" data-wow-delay="0.1s">

            <div style="background:#222429;border-radius:8px;overflow:hidden;">
                <div class="p-4" style="background:#111;border-bottom:2px solid var(--ch-primary);">
                    <h5 class="text-white mb-0">
                        Pour : <span class="text-primary">{{ recette.titre }}</span>
                    </h5>
                </div>
                <div class="p-5 form-dark">
                    {{ form_start(form) }}
                        <div class="mb-4">
                            <label class="form-label text-secondary">Nom de l'ingrédient *</label>
                            {{ form_widget(form.nom, {attr: {class: 'form-control', placeholder: 'Ex: Farine, Beurre...'}}) }}
                            {{ form_errors(form.nom) }}
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-secondary">Quantité *</label>
                            {{ form_widget(form.quantite, {attr: {class: 'form-control', placeholder: 'Ex: 200g, 2 tasses, 3...'}}) }}
                            {{ form_errors(form.quantite) }}
                        </div>
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary py-3 flex-grow-1">
                                <i class="bi bi-plus-circle me-2"></i>Ajouter
                            </button>
                            <a href="{{ path('recette_show', {id: recette.id}) }}" class="btn btn-outline-secondary py-3 px-4">
                                Annuler
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

        </div>
    </div>
</div>

<div class="mb-5"></div>
{% endblock %}
